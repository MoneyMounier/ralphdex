{
  "name": "ralphdex",
  "displayName": "Ralphdex",
  "description": "Runs Ralph loops in VS Code by repeatedly invoking Codex with a bundled loop prompt.",
  "version": "0.1.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/MoneyMounier/ralphdex.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:ralphdex.controlView",
    "onCommand:ralphdex.openControl",
    "onCommand:ralphdex.startLoop",
    "onCommand:ralphdex.continueLoop",
    "onCommand:ralphdex.runIteration",
    "onCommand:ralphdex.endLoopAfterCurrent",
    "onCommand:ralphdex.stopLoop"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ralphdex",
          "title": "Ralphdex",
          "icon": "media/ralphdex.svg"
        }
      ]
    },
    "views": {
      "ralphdex": [
        {
          "id": "ralphdex.controlView",
          "name": "Controls",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "ralphdex.openControl",
        "title": "Ralphdex: Open Controls",
        "category": "Ralphdex"
      },
      {
        "command": "ralphdex.startLoop",
        "title": "Ralphdex: Start Ralph Loop",
        "category": "Ralphdex"
      },
      {
        "command": "ralphdex.continueLoop",
        "title": "Ralphdex: Continue Ralph Loop",
        "category": "Ralphdex"
      },
      {
        "command": "ralphdex.runIteration",
        "title": "Ralphdex: Run One Ralph Iteration",
        "category": "Ralphdex"
      },
      {
        "command": "ralphdex.endLoopAfterCurrent",
        "title": "Ralphdex: End Loop After Current Iteration",
        "category": "Ralphdex"
      },
      {
        "command": "ralphdex.stopLoop",
        "title": "Ralphdex: Stop Ralph Loop",
        "category": "Ralphdex"
      }
    ],
    "configuration": {
      "title": "Ralphdex",
      "properties": {
        "ralphdex.taskPath": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative default task file used if a task picker is cancelled."
        },
        "ralphdex.codexCommand": {
          "type": "string",
          "default": "codex",
          "description": "Command used to start the Codex CLI."
        },
        "ralphdex.codexArgs": {
          "type": "array",
          "default": [
            "exec",
            "--cd",
            "${workspaceFolder}",
            "-"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the Codex command. Supports ${workspaceFolder}, ${promptPath}, and ${prompt}."
        },
        "ralphdex.sendPromptToStdin": {
          "type": "boolean",
          "default": true,
          "description": "Send the prompt file contents to Codex over stdin. The default arguments use `-` so Codex reads stdin."
        },
        "ralphdex.maxIterations": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Maximum number of Codex iterations to run when starting the loop."
        },
        "ralphdex.model": {
          "type": "string",
          "default": "",
          "description": "Optional Codex model to use for Ralphdex runs. Leave blank to use the CLI default."
        },
        "ralphdex.modelSuggestions": {
          "type": "array",
          "default": [
            "gpt-5.5",
            "gpt-5.4",
            "gpt-5.4-mini",
            "gpt-5.3-codex",
            "gpt-5.2"
          ],
          "items": {
            "type": "string"
          },
          "description": "Suggested model IDs shown in the Ralphdex UI model picker."
        },
        "ralphdex.modelReasoningEffort": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Use the model's default reasoning effort.",
            "Fastest option with the lowest reasoning effort.",
            "Balanced speed and intelligence.",
            "Highest reasoning effort, usually the slowest."
          ],
          "description": "Optional Codex reasoning effort used to trade speed for intelligence."
        },
        "ralphdex.stopWhenNoGapRemaining": {
          "type": "boolean",
          "default": true,
          "description": "Stop the loop when the iteration summary says the highest-value gap remaining is none."
        }
      }
    }
  }
}
